---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="404 — 基準線から外れました。 | TechWedge"
  description="お探しのページは見つかりませんでした。"
  path="/404"
  noindex
>

<main>
<div class="lost">
  <div class="cutline"></div>
  <div style="font-family:var(--mono);font-size:12px;letter-spacing:.34em;color:var(--laser)">404 — NOT FOUND</div>
  <p style="color:var(--sub);margin-top:16px;font-size:14px">お探しのページは見つかりませんでした。</p>
  <a class="cta" href="/" style="margin-top:34px">トップへ戻る →</a>
</div>
</main>

</Layout>
