---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactBand from "../components/ContactBand.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import { receiptBefore, receiptAfter } from "../data/receipt-case";
---
<Layout
  title="導入事例 — 作った本人が、まず自分で使う。 | TechWedge"
  description="TechWedgeの導入事例。領収書仕分け自動化は自社実測で月平均170分→20分。問い合わせ自動返信は自社サイトへの実装が第一号です。実数は一次ソースから、盛らずに公開しています。"
  path="/cases"
>

<Header current="cases" />

<main>

<!-- ═══ HERO ═══ -->
<section class="hero compact">
  <div class="wrap">
    <div class="kicker">CASE STUDIES — 導入事例</div>
    <h1>作った本人が、<br><span class="laser-under">まず自分で使う。</span></h1>
    <p class="hero-lead">
      売る前に、自分たちの会社で使っています。ここに載せているのは、私たち自身が実際に回した結果です。<br>
      できていないことを、できていると言わないチームです。
    </p>
  </div>
</section>

<!-- ═══ 01 事例No.001 領収書仕分け ═══ -->
<section class="band" id="proof">
  <div class="wrap">
    <div class="sec-head"><span class="sec-num">01</span><h2>領収書仕分け自動化</h2><span class="sec-en">Case No.001</span></div>
    <p class="sec-lead">株式会社myshia（内装系金物の施工・大阪・このチームの発起人が現場に立つ会社）</p>
    <BeforeAfter before={receiptBefore} after={receiptAfter} />
    <p class="src-note">DATA: 2026年1月〜6月 / 自動処理された領収書400件（法人332件＋個人事業68件） / 手作業の工程ごとの時間（約170分）と、AI を使った後の時間（約20分）を比べた数字です。AI を使った後の時間は、自社で実際に回した結果です。導入環境により変動します</p>
    <div class="card rv" style="margin-top:40px;max-width:840px">
      <span class="tag on-sale">提供中</span>
      <h3>スキャンするだけで、月末の仕分け作業が消えた</h3>
      <p class="desc">2事業者分の領収書が混在する環境で、カード番号による自動判別を含めて6ヶ月運用。月平均170分かかっていた作業が20分になり、税理士への受け渡しも常に同期された状態に。</p>
    </div>
  </div>
</section>

<!-- ═══ 02 事例No.002 メール自動返信 ═══ -->
<section>
  <div class="wrap">
    <div class="sec-head"><span class="sec-num">02</span><h2>問い合わせ自動返信</h2><span class="sec-en">Case No.002</span></div>
    <p class="sec-lead">TechWedge自社サイト（tech-wedge.com・このサイト自体が実装第一号）</p>
    <div class="grid">
      <div class="card rv">
        <h3 style="margin-top:0">BEFORE</h3>
        <p class="desc">お問い合わせフォームからの送信後、一次返信は担当が気づき次第の手動対応でした。</p>
      </div>
      <div class="card rv">
        <h3 style="margin-top:0">AFTER</h3>
        <p class="desc">フォーム送信と同時に、受領確認メールが自動で届く仕組みに変更。送信内容はスプレッドシートへの記録・担当への通知も同時に走ります。</p>
      </div>
    </div>
    <p class="src-note">DATA: 2026-07-21実施の実弾テストで、自動返信メール・担当への通知メールの両方が送信直後に到達することを確認済み</p>
    <div class="card rv" style="margin-top:40px;max-width:840px">
      <span class="tag on-sale">提供中</span>
      <h3>「まず自分たちの窓口」で検証してから、お客様へ</h3>
      <p class="desc">建設業のお客様に提供する前に、まず自社サイトの問い合わせ窓口に実装（ドッグフーディング）。受信モードの切り替えは設定シートだけで完結する設計のため、コード変更なしでお客様先へ展開できます。</p>
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<ContactBand ctaLabel="自社でも対象になるか相談する →">
  <h2 slot="heading">あなたの会社の番です。</h2>
  <p>30分の無料相談で、今の作業のどこが自動化できるか（できないか）をお伝えします。</p>
</ContactBand>

</main>

<Footer />
</Layout>
