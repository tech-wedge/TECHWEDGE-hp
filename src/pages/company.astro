---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactBand from "../components/ContactBand.astro";
import { members } from "../data/members";
---
<Layout
  title="運営者情報 — 現場を知ってる3人です。 | TechWedge"
  description="TechWedgeの運営チーム。発起人は内装金物の現役職人。自社の領収書の仕分けの時間をAIで約9割短縮した実体験がこのチームの原点です。"
  path="/company"
>

<Header current="company" />

<main>

<!-- ═══ HERO ═══ -->
<section class="hero compact">
  <div class="wrap">
    <div class="kicker">WHO WE ARE — 運営チーム</div>
    <h1>現場を知ってる<br><span class="laser-under">3人です。</span></h1>
  </div>
</section>

<!-- ═══ 01 原点 ═══ -->
<section class="band">
  <div class="wrap">
    <div class="sec-head"><span class="sec-num">01</span><h2>原点</h2><span class="sec-en">Story</span></div>
    <div class="story rv">
      発起人の中芝は、今も内装金物の職人です。<b>昼は現場に立ち、夜は自社の事務をAIで自動化してきました。</b>月平均170分かかっていた領収書の仕分けが20分になった——この実体験が、チームの原点です。<br><br>
      だから私たちの提案は「ツールの説明」ではなく「<b>現場の人間が実際に使って残った仕組み</b>」の話です。使えなかったものは、自分たちの段階で捨てています。
    </div>
  </div>
</section>

<!-- ═══ 02 チームの合言葉 ═══ -->
<section>
  <div class="wrap">
    <div class="sec-head"><span class="sec-num">02</span><h2>チームの合言葉</h2><span class="sec-en">Motto</span></div>
    <div class="story rv">
      <p style="font-size:clamp(20px,3vw,26px);font-weight:900;color:var(--ink);margin-bottom:18px">「これまでの常識にくさびを打ち込め」</p>
      くさび（wedge）は、古い常識ややり方を割って壊す現場の道具であると同時に、足場や部材をしっかり繋ぎ留める道具でもあります。<b>TechWedge</b>という名前には、この両方の意味を込めました——非効率を壊す道具であり、現場とテクノロジーを繋ぐ道具でもある、という私たちのスタンスです。
    </div>
  </div>
</section>

<!-- ═══ 03 メンバー ═══ -->
<section>
  <div class="wrap">
    <div class="sec-head"><span class="sec-num">03</span><h2>メンバー</h2><span class="sec-en">Members</span></div>
    <div class="grid">
      {members.map((member) => (
        <div class="member rv">
          <div class="avatar">{member.initials}</div>
          <h3>{member.name}</h3>
          <div class="role">{member.role}</div>
          <p>{member.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ 04 概要 ═══ -->
<section class="band">
  <div class="wrap">
    <div class="sec-head"><span class="sec-num">04</span><h2>概要</h2><span class="sec-en">Profile</span></div>
    <table class="spec-table rv">
      <tr><th>名称</th><td>TechWedge</td></tr>
      <tr><th>拠点</th><td>大阪 — オンラインで全国対応</td></tr>
      <tr><th>事業内容</th><td>中小企業向け 業務自動化ツールの提供 / AI導入サポート / AI研修</td></tr>
      <tr><th>実績</th><td class="num">自社実運用 400件・6ヶ月 / 領収書の仕分け 約88%削減</td></tr>
      <tr><th>連絡先</th><td><a href="/contact" style="color:var(--laser)">無料相談フォーム</a> / <span style="white-space:nowrap">X <a href="https://x.com/jidoka_yudai" target="_blank" rel="noopener" style="color:var(--laser)">@jidoka_yudai</a></span></td></tr>
    </table>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<ContactBand ctaLabel="無料相談へ →">
  <h2 slot="heading">気になることがあれば、<br>お気軽にご相談ください。</h2>
  <p>大きい会社の営業窓口ではなく、作っている本人が話を聞きます。</p>
</ContactBand>

</main>

<Footer />
</Layout>
